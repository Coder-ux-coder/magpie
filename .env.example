# Magpie configuration. The easy way: run the setup (setup.cmd on Windows, sh setup.sh
# on Mac/Linux, or `magpie setup`), which asks a few questions and writes .env for you.
# Or copy this file to .env and fill it in. Everything is optional: the AI, email and
# your categories can all be set up in Magpie itself (the welcome screen and Settings).
# Restart Magpie after changing this file.

# --- AI ------------------------------------------------------------------------

# Your Claude API key, from https://console.anthropic.com/settings/keys
# (Or leave it empty and choose an AI in Magpie: Claude, ChatGPT, Gemini, OpenRouter,
# Ollama on this computer, any OpenAI-compatible service, or no AI at all.)
ANTHROPIC_API_KEY=

# Fix the AI on the server instead of choosing it in Magpie:
# claude, openai, gemini, openrouter, ollama, compatible, basic (no AI) or fake (demos).
# MAGPIE_BRAIN=claude
# For any of them except Claude: its API key, and an address for ollama/compatible.
# MAGPIE_AI_API_KEY=
# MAGPIE_AI_BASE_URL=https://api.groq.com/openai/v1

# --- Password ------------------------------------------------------------------

# No password (the setup's default): Magpie opens straight away, but only on this
# computer. Set a password (and MAGPIE_BIND=0.0.0.0) to open it from other devices.
# MAGPIE_LOGIN=false
# MAGPIE_PASSWORD=

# --- Updates and network ------------------------------------------------------

# Magpie updates itself: it checks for a new version every hour and restarts on it.
# MAGPIE_AUTO_UPDATE=false
# Stay on one version (every build is tagged sha-<commit>), e.g. MAGPIE_VERSION=sha-0e24363
# MAGPIE_VERSION=latest
# Who can open Magpie: 127.0.0.1 = only this computer (fine without a password);
# 0.0.0.0 = other devices on your network too (set a password first).
# MAGPIE_BIND=127.0.0.1
# Use another port on this computer if 8000 is taken.
# MAGPIE_HOST_PORT=8000

# --- Basics -----------------------------------------------------------------

# Your time zone (IANA name), used for reminders and digests. You can also
# change it in Settings. Examples: Europe/London, America/New_York, Australia/Sydney
MAGPIE_TIMEZONE=UTC

# The address you open Magpie at, e.g. https://notes.example.com. Needed for
# "Open" and one-tap Done/Snooze links in notifications. Leave empty for local use.
MAGPIE_BASE_URL=

# With `docker compose --profile https up -d`, Caddy gets a certificate for
# this domain (point its DNS at your server first). Example: notes.example.com
MAGPIE_DOMAIN=

# Where notes are stored (the Docker image uses /data).
# MAGPIE_DATA_DIR=data
# MAGPIE_HOST=127.0.0.1
# MAGPIE_PORT=8000

# --- Claude -------------------------------------------------------------------

# The model, for whichever AI is chosen here. Claude's default is claude-haiku-5-5 (fast
# and low-cost); claude-sonnet-5-5 and claude-opus-5-5 are more capable. You can also
# pick the model in Settings -> AI.
# MAGPIE_MODEL=claude-haiku-5-5

# Let Claude search the web for videos and articles you mention without a link.
MAGPIE_WEB_SEARCH=true

# Override how hard Claude thinks for every task: low, medium, high, xhigh, max.
# Leave empty for sensible per-task defaults (low for filing notes).
# MAGPIE_EFFORT=

# Retry declined requests on Anthropic's recommended fallback model.
# MAGPIE_FALLBACKS=true

# --- Telegram (recommended: capture by text or voice, get reminders) --------

# Create a bot with @BotFather and paste its token here. Then open
# Settings -> Reminders -> Connect Telegram in the dashboard.
MAGPIE_TELEGRAM_BOT_TOKEN=
# Optional: skip the pairing step by setting your chat id directly.
# MAGPIE_TELEGRAM_CHAT_ID=

# --- Speech-to-text on the server (Telegram voice notes, Firefox) ------------

# Any OpenAI-compatible /audio/transcriptions service.
# OpenAI:  base https://api.openai.com/v1, model whisper-1 (or gpt-4o-transcribe)
# Groq:    base https://api.groq.com/openai/v1, model whisper-large-v3-turbo
MAGPIE_STT_API_KEY=
MAGPIE_STT_BASE_URL=https://api.openai.com/v1
MAGPIE_STT_MODEL=whisper-1
# Language of the recordings (ISO 639-1). Magpie expects English.
# MAGPIE_STT_LANGUAGE=en

# --- Other notification channels (all optional) ------------------------------

# ntfy: install the ntfy app and subscribe to a long, secret topic name.
MAGPIE_NTFY_TOPIC=
# MAGPIE_NTFY_SERVER=https://ntfy.sh
# MAGPIE_NTFY_TOKEN=

# Email (SMTP). Easier: Settings -> Reminders -> Email, which only needs your address
# and an app password for Gmail, Outlook, Yahoo or iCloud.
MAGPIE_SMTP_HOST=
# MAGPIE_SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
# MAGPIE_SMTP_SECURITY=starttls
MAGPIE_SMTP_USERNAME=
MAGPIE_SMTP_PASSWORD=
# MAGPIE_SMTP_FROM=
MAGPIE_EMAIL_TO=

# Webhook: Slack, Discord, or any URL that accepts JSON.
MAGPIE_WEBHOOK_URL=
# json, slack or discord
# MAGPIE_WEBHOOK_FORMAT=json

# Pop-up notifications work without configuration (Settings -> Reminders).
# Contact address sent to push services:
# MAGPIE_VAPID_SUBJECT=mailto:you@example.com

# --- Advanced ------------------------------------------------------------------

# API token for Siri Shortcuts, scripts and the MCP server. Generated if empty
# (shown in Settings -> Integrations).
# MAGPIE_API_TOKEN=
# Cookie-signing secret. Generated if empty.
# MAGPIE_SECRET_KEY=
# Allow reviewing links on your private network (off for safety).
# MAGPIE_ALLOW_PRIVATE_URLS=false
# MAGPIE_LOG_LEVEL=info
